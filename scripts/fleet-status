#!/bin/sh
# Fleet counts for a herdr tab-bar command entry: prints one line such as
# "×2 ✓1 ◐7 ○3" (blocked, done, working, idle) using herdr's own
# status_indicators = "symbols" glyphs, in attention order. Zero-count
# states are omitted. Prints nothing on failure or with no agents so herdr
# clears the entry instead of showing stale counts.
# Requires: herdr, jq.

set -eu

herdr agent list 2>/dev/null | jq -r '
  .result.agents
  | select(length > 0)
  | group_by(.agent_status)
  | sort_by(({blocked: 0, done: 1, working: 2, idle: 3, unknown: 4}[.[0].agent_status] // 5))
  | map(
      ({"blocked": "×", "working": "◐", "done": "✓", "idle": "○", "unknown": "·"}[.[0].agent_status] // "?")
      + (length | tostring)
    )
  | join(" ")
'
